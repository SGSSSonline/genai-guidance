figure.facecolor: "#24273a"
axes.facecolor: "#24273a"
text.color: "#cad3f5"
axes.labelcolor: "#cad3f5"
xtick.color: "#cad3f5"
ytick.color: "#cad3f5"
axes.edgecolor: "#a5adcb"
grid.color: "#363a4f"
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False
font.family: Open Sans
font.monospace: Inconsolata
legend.edgecolor: "#24273a"
axes.prop_cycle: cycler('color', ["#8aadf4", "#f5bde6", "#a6da95", "#f5a97f", "#c6a0f6", "#eed49f", "#8bd5ca", "#ed8796"])
